# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key (required for admin operations — keep server-side only, never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack Payment Gateway Configuration (Ghana Mobile Money & International Cards)
# For local dev / QA, use Test Keys. For production live payments, swap to Live Keys.
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Resend — Transactional email (verification emails, auth flows)
# Sign up free at https://resend.com — 3,000 emails/month
RESEND_API_KEY=re_...

# Canonical production URL — used in emailRedirectTo so verification
# links always point to your live domain regardless of deployment URL.
NEXT_PUBLIC_SITE_URL=https://www.civitasestate.com

# Telemetry API Key (used by solar inverters and IoT submeters to ingest real-time readings)
TELEMETRY_API_KEY=your-telemetry-secret-key

# Africa's Talking (WhatsApp & SMS transactional alerts)
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=your-africas-talking-username
AT_SMS_FROM=CIVITAS
AT_WHATSAPP_FROM=+233...

