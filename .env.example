# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key (required for admin operations — keep server-side only, never expose in browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack Payment Gateway Configuration
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Resend — Transactional email (verification emails, auth flows)
# Sign up free at https://resend.com — 3,000 emails/month
RESEND_API_KEY=re_...

# Canonical production URL — used in emailRedirectTo so verification
# links always point to your live domain regardless of deployment URL.
NEXT_PUBLIC_SITE_URL=https://www.civitasestate.com

